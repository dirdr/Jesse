# Copy to .env and fill locally. Never commit real credentials.
# H Company Agents API authentication
HAI_API_KEY=
# Gladia transcription (reserved for the voice slice)
GLADIA_API_KEY=
OPENAI_KEY=
ANTHROPIC_KEY=
# Optional planner model; OPENAI_API_KEY is also accepted instead of OPENAI_KEY.
OPENAI_MODEL=gpt-5-mini
ELEVENLABS_API_KEY=
# Fish Audio takes priority when configured. This is Jesse's selected reference voice.
FISH_API_KEY=
JESSE_FISH_VOICE=ecef5efd79bb49c7bcbf3511fff8d20c
# Optional Fish model header; blank uses the provider default.
JESSE_FISH_MODEL=
# Cheeky lab-partner personality is the default; use plain for a neutral colleague.
JESSE_PERSONA=pinkman
# Optional speech writer and OpenAI voice overrides.
JESSE_SPEECH_MODEL=gpt-4.1
JESSE_TTS_MODEL=gpt-4o-mini-tts
JESSE_TTS_VOICE=ash

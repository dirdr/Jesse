# Copy to .env and fill locally. Never commit real credentials.
# H Company Agents API authentication
HAI_API_KEY=
# Gladia transcription (reserved for the voice slice)
GLADIA_API_KEY=
OPENAI_KEY=
ANTHROPIC_KEY=
# Optional planner model; OPENAI_API_KEY is also accepted instead of OPENAI_KEY.
OPENAI_MODEL=gpt-5-mini
# Pinkman bundles its character and fixed Fish voice; plain bundles a neutral character and OpenAI voice.
FISH_API_KEY=
JESSE_PERSONA=pinkman
# Optional speech writer model override. Voice and TTS model come from the selected persona.
JESSE_SPEECH_MODEL=gpt-4.1
